---
import BaseLayout from './BaseLayout.astro';
import ProjectToc from '../components/ProjectToc.astro';
import RepositoryAccess from '../components/RepositoryAccess.astro';
import { statusLabel } from '../lib/projects';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
interface Props { project: CollectionEntry<'projects'>; headings: MarkdownHeading[]; }
const { project, headings } = Astro.props;
const d = project.data;
const toc = [{slug:'overview',text:'Overview'}, {slug:'my-contribution',text:'My contribution'}, ...headings.filter(h => h.depth === 2)];
---
<BaseLayout title={`${d.title} | Junghun Hwang`} description={d.summary}>
  <main id="main" class="case-page container">
    <a class="back-link" href="/#projects">← All projects</a>
    <header class="case-header">
      <p class="eyebrow">Project {String(d.order).padStart(2,'0')} / {d.context}</p>
      <h1>{d.title}</h1>
      <dl class="project-meta"><div><dt>Period</dt><dd>{d.period}</dd></div>{d.team && <div><dt>Team</dt><dd>{d.team}</dd></div>}<div><dt>Role</dt><dd>{d.role}</dd></div><div><dt>Status</dt><dd><span class={`status ${d.status}`}>{statusLabel.en[d.status]}</span></dd></div></dl>
      {d.github && <RepositoryAccess href={d.github} visibility={d.githubVisibility} privateReason={d.githubPrivateReason} label="GitHub repository" />}
    </header>
    <div class="case-grid"><ProjectToc items={toc} /><article class="case-content">
      <section aria-labelledby="overview"><h2 id="overview">Overview</h2><p class="lead">{d.summary}</p><p class="outcome"><strong>Outcome</strong> {d.outcome}</p></section>
      <section class="contribution-section" aria-labelledby="my-contribution"><h2 id="my-contribution">My contribution</h2><p class="scope-label">Team scope</p><p>{d.teamScope}</p><p class="scope-label">My work</p><ul>{d.contributions.map(item => <li>{item}</li>)}</ul></section>
      <slot />
    </article></div>
  </main>
</BaseLayout>

<style>
  .case-page { padding-top: 34px; }
  .back-link { color: var(--muted); font-size: .8rem; }
  .back-link:hover { color: var(--accent); }
  .case-header { padding: 34px 38px; margin-top: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--soft); }
  .case-header h1 { margin-top: 14px; max-width: 920px; font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 600; }
  .case-header > .eyebrow { font-family: var(--font); font-size: .67rem; }
  .project-meta { margin-top: 28px; padding-top: 23px; border-top: 1px solid var(--line); }
  .project-meta dt { font-size: .65rem; }
  .project-meta dd { font-size: .83rem; }
  .case-header :global(.repository-private), .case-header :global(.repository-link) { margin-top: 23px; }
  .case-grid { grid-template-columns: 205px minmax(0, 1fr); gap: 60px; margin-top: 46px; }
  .case-content :global(h2) { font-size: 1.65rem; padding-top: 32px; margin-top: 52px; }
  .case-content :global(h2::before) { font-size: .67rem; color: var(--muted); margin-bottom: 10px; }
  .case-content :global(h3) { font-size: 1.15rem; }
  .case-content :global(p), .case-content :global(li) { font-size: .95rem; line-height: 1.9; }
  .case-content :global(.lead) { font-size: 1.12rem; line-height: 1.85; }
  .case-content :global(.outcome) { border: 0; border-radius: 8px; padding: 20px 24px; line-height: 1.85; }
  .case-content :global(.outcome strong) { color: var(--accent); font-size: .72rem; }
  .case-content :global(.scope-label) { font-size: .7rem !important; }
  .contribution-section ul { padding-left: 24px; border: 0; }
  .contribution-section li::marker { color: var(--accent); }
  .case-content :global(figure img) { border-radius: 7px; }
  .case-content :global(figcaption) { font-size: .78rem; }
  @media (max-width: 1000px) { .case-grid { grid-template-columns: 180px minmax(0, 1fr); gap: 35px; } }
  @media (max-width: 760px) {
    .case-header { padding: 25px 22px; margin-top: 20px; }
    .case-header h1 { font-size: 2rem; }
    .case-grid { display: block; margin-top: 26px; }
    .case-content :global(h2) { font-size: 1.5rem; }
    .case-content :global(p), .case-content :global(li) { font-size: .9375rem; }
    .case-content :global(.lead) { font-size: 1.05rem; }
    .case-content :global(table) { display: block; max-width: 100%; overflow-x: auto; }
    .case-content :global(th), .case-content :global(td) { min-width: 130px; }
    .case-content :global(.outcome) { padding: 17px 19px; }
  }
  @media print { .case-header { background: none; padding: 0 0 20px; border: 0; } .case-grid { display: block; } }
</style>
