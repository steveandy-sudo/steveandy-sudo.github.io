---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchInterests from './ResearchInterests.astro';
import ReservedMedia from './ReservedMedia.astro';
import RepositoryAccess from './RepositoryAccess.astro';
import { allProjects, projectUrl, statusLabel } from '../lib/projects';

const research = {
  lead: 'I want to study perception and decision-making for autonomous driving, with a focus on deep learning.',
  summary: 'Building an imitation-learning pipeline and integrating ROS 2 decision and control software led me to study how sensor-based predictions affect vehicle behavior. I am particularly interested in implementing end-to-end (E2E) driving models and examining their behavior under occlusion and input delay. My current experiment design compares camera-only driving with infrastructure-camera assistance when a pedestrian is hidden by a parked vehicle.',
  topics: [
    { title: 'Perception under occlusion', description: 'How can a vehicle respond to what it cannot yet see?' },
    { title: 'Decisions and vehicle response', description: 'How do input and steering delays change driving behavior?' },
    { title: 'Learning-based & E2E driving', description: 'How can experiments reveal the limits of learned behavior?' },
  ],
};
const entries = await allProjects();
const projects = entries.filter(({data}) => data.lang === 'en' && data.featured);
type HomeProject = {
  title: string; summary: string; result: string;
  visual?: { src?: string; alt?: string; title: string; caption?: string; kind?: 'image' | 'video' };
};
const projectCopy: Record<string, HomeProject> = {
  'kookmin-ai-edge': {
    title: 'Kookmin AI-Edge Challenge',
    summary: 'Built an imitation-learning pipeline, trained a YOLO detector, and integrated mission logic on the competition vehicle.',
    result: 'Team result: preliminary 2nd, finals 13th with course completion, and Parking Special Award.',
    visual: {
      src: '/media/projects/kookmin-ai-edge/01-competition-vehicle.jpg',
      alt: 'Team KAI competition vehicle on the Kookmin course',
      title: 'Competition vehicle',
      caption: 'Competition broadcast · Team KAI vehicle',
    },
  },
  'ai-sw-mobility': {
    title: 'AI·SW Mobility: Decision-Making & AEB',
    summary: 'Developed cone-boundary path generation, red-cone-triggered stop commands, and Pure Pursuit + Stanley tracking with steering limits; tested the pipeline in Gazebo and on the vehicle.',
    result: 'Venue practice, Sep 19–20: real-vehicle waypoint driving on both courses at 10 m/s (36 km/h), and AEB stop commands at 50 km/h.',
    visual: {
      src: '/media/projects/ai-sw-mobility/03-final-course-waypoint-poster.jpg',
      alt: 'Onboard view of final-course waypoint driving',
      title: 'Final-course venue practice',
      caption: 'Final-course waypoint driving · Venue practice',
    },
  },
  'camera-v2i-e2e': {
    title: 'Camera-Based V2I & End-to-End Driving',
    summary: 'Designing camera-only and V2I-assisted E2E driving for a 1/5-scale test vehicle in an occluded-pedestrian scenario.',
    result: 'Week 4: operating domain defined; system requirements, homography, latency and stopping-distance budgets in design. Implementation is planned.',
    visual: { src: '/media/projects/camera-v2i/02-week4-e2e-comparison.png', alt: 'Week-4 camera-only and V2I-assisted E2E comparison design', title: 'E2E comparison design', caption: 'Week 4 · Proposed comparison architecture', kind: 'image' },
  },
  'uav-waypoint': {
    title: 'UAV Waypoint Mission',
    summary: 'A ROS 2 mission package for sequential 3D waypoints, TF2 arrival checks, and PX4 offboard integration.',
    result: 'Waypoint tracking and final landing completed in the PX4 SITL/Gazebo demonstration.',
    visual: {
      src: '/media/projects/uav-waypoint/01-waypoint-flight-poster.jpg',
      alt: 'UAV flying past a building during a simulated waypoint test',
      title: 'UAV waypoint flight',
      caption: 'PX4 SITL / Gazebo · Waypoint flight',
      kind: 'image',
    },
  },
  'vmodel-neuro-symbolic': {
    title: 'Dream Semester: Decision & Control',
    summary: 'An early ROS 2 / CARLA project exploring Pure Pursuit, longitudinal control, and vehicle-command integration.',
    result: 'Path tracking remained unstable in simulation. The project ended without achieving stable autonomous driving or a real-vehicle run.',
    visual: {
      src: '/media/projects/vmodel-neuro-symbolic/01-carla-simulation-poster.jpg',
      alt: 'Dream Semester CARLA simulation with ROS 2 control terminals',
      title: 'CARLA simulation test',
      caption: 'Dream Semester · CARLA simulation test',
      kind: 'image',
    },
  },
};
const skills = [
  { label: 'Programming', tools: 'Python, C++' },
  { label: 'Autonomous systems', tools: 'ROS 2, CARLA, Gazebo, PX4 SITL' },
  { label: 'AI & computer vision', tools: 'PyTorch, YOLO, OpenCV, Roboflow' },
  { label: 'Development & inspection', tools: 'Ubuntu, Git/GitHub, Foxglove, RViz2, rosbag2, QGroundControl' },
];
---
<BaseLayout title="Junghun Hwang | Autonomous Driving & AI Portfolio" description={'Engineering work in autonomous driving, ROS 2 decision-making, AI perception, and system integration. Technical case studies by Junghun Hwang.'}>
  <main id="main" class="container home-page">
    <section class="intro" aria-labelledby="intro-title">
      <figure class="intro-profile">
        <img src="/media/profile/junghun-hwang.jpg" alt="Portrait of Junghun Hwang" width="1018" height="1357" fetchpriority="high" />
        <figcaption>{'B.S. expected February 2027'}</figcaption>
      </figure>
      <div class="intro-copy">
        <p class="eyebrow">{'Konkuk University / Smart Mobility Engineering'}</p>
        <h1 id="intro-title">Junghun Hwang <span lang="ko">황정헌</span></h1>
        <p class="intro-field">Autonomous Driving · Perception · Learning</p>
        <p class="intro-summary">{'I study Smart Mobility Engineering at Konkuk University. I develop ROS 2 decision and control software, train perception models, and test their integration in simulation and on autonomous vehicles.'}</p>
        <dl class="intro-details">
          <div><dt>{'Born'}</dt><dd><time datetime="2001-12-10">2001.12.10</time></dd></div>
          <div><dt>{'Based in'}</dt><dd>Seoul, Korea</dd></div>
        </dl>
        <div class="intro-links">
          <a class="primary-link" href="#projects">{'Explore projects'} <span aria-hidden="true">↓</span></a>
          <a class="email-link" href="mailto:stevehwang1210@gmail.com">stevehwang1210@gmail.com <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <ResearchInterests {...research} />
    <section id="projects" class="home-section projects-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div><h2 id="projects-title">{'Projects'}</h2></div>
      </div>
      <ol class="project-list">
        {projects.map(({ data }) => {
          const copy = projectCopy[data.slug];
          const visual = copy?.visual;
          const url = projectUrl(data);
          return (
            <li class:list={['project-entry', { 'has-media': !!visual }]}>
              <div class="project-heading">
                <span class="project-index" aria-hidden="true">{String(data.order).padStart(2, '0')}</span>
                <p class="project-context">{data.context}</p>
                <span class={`status ${data.status}`}>{statusLabel.en[data.status]}</span>
              </div>
              <div class="project-summary">
                <h3><a href={url}>{copy?.title ?? data.title}</a></h3>
                <p class="project-description">{copy?.summary ?? data.summary}</p>
                <dl class="project-facts">
                  <div><dt>{'Period'}</dt><dd>{data.period}</dd></div>
                  <div><dt>{'Role'}</dt><dd>{data.role}</dd></div>
                </dl>
                <div class="project-evidence"><span>{'Outcome / current stage'}</span><p>{copy?.result ?? data.outcome}</p></div>
                <ul class="project-tech" aria-label={'Technologies'}>{data.technologies.map(tech => <li>{tech}</li>)}</ul>
                {data.github && <div class="project-links">
                  <RepositoryAccess href={data.github} visibility={data.githubVisibility} privateReason={data.githubPrivateReason} label="GitHub" accessibleName={`${copy?.title ?? data.title} — GitHub`} />
                </div>}
              </div>
              {visual && <div class="project-visual">
                {visual.src ? <figure>
                  <a class="project-preview" href={url}><img src={visual.src} alt={visual.alt ?? visual.title} width={['uav-waypoint', 'vmodel-neuro-symbolic'].includes(data.slug) ? 960 : data.slug === 'ai-sw-mobility' ? 1280 : data.slug === 'camera-v2i-e2e' ? 1600 : 1576} height={['uav-waypoint', 'vmodel-neuro-symbolic'].includes(data.slug) ? 540 : data.slug === 'ai-sw-mobility' ? 720 : data.slug === 'camera-v2i-e2e' ? 900 : 884} loading="lazy" decoding="async" /></a>
                  <figcaption>{visual.caption}</figcaption>
                </figure> : <ReservedMedia title={visual.title} kind={visual.kind ?? 'image'} />}
              </div>}
            </li>
          );
        })}
      </ol>
    </section>
    <div class="background-sections">
      <section id="awards" class="home-section" aria-labelledby="awards-title">
        <div class="section-heading"><div><p class="eyebrow">{'Competition record'}</p><h2 id="awards-title">{'Awards & competitions'}</h2></div></div>
        <div class="award-row"><span class="year">2026</span><div><h3>{'Kookmin AI-Edge Challenge'}</h3><p>{'Parking Special Award · Preliminary 2nd'}</p><p class="small-muted">{'Finals 13th, course completed · Team result'}</p></div></div>
        <div class="award-row"><span class="year">2022</span><div><h3>Drone Clash</h3><p>{'General Division · 3rd Place'}</p></div></div>
      </section>
      <section id="skills" class="home-section" aria-labelledby="skills-title">
        <div class="section-heading"><div><p class="eyebrow">{'Tools used in projects'}</p><h2 id="skills-title">{'Technical skills'}</h2></div></div>
        <dl class="skills-list">{skills.map(({label,tools}) => <div><dt>{label}</dt><dd>{tools}</dd></div>)}</dl>
      </section>
    </div>
  </main>
</BaseLayout>
<style>
  .intro { max-width: 1020px; margin-inline: auto; padding: 62px 0 66px; grid-template-columns: 214px minmax(0, 1fr); align-items: center; gap: clamp(36px, 5vw, 76px); }
  .intro-profile { width: 214px; max-width: 100%; }
  .intro-profile img { width: 100%; height: auto; aspect-ratio: 1018 / 1357; object-fit: cover; border: 1px solid var(--line); border-radius: 4px; }
  .intro-profile figcaption { margin-top: 12px; color: var(--muted); font-size: .75rem; text-align: center; }
  .intro h1 { font-size: clamp(2.2rem, 4.2vw, 3.25rem); margin: 17px 0; }
  .intro-field { font-size: 1rem; }
  .intro-summary { max-width: 640px; margin-top: 19px; font-size: .975rem; }
  .intro-details { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 19px; font-size: .8125rem; }
  .intro-details > div { display: flex; flex-wrap: wrap; gap: 4px 10px; }
  .intro-details dt { color: var(--muted); }
  .intro-details dd { color: var(--ink); }
  .intro-links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 26px; font-size: .8125rem; }
  .primary-link { display: inline-flex; gap: 22px; justify-content: space-between; align-items: center; background: var(--ink); color: #fff; padding: 9px 15px; border: 1px solid var(--ink); border-radius: 3px; text-decoration: none; }
  .primary-link:hover { background: var(--accent); border-color: var(--accent); }
  .email-link { overflow-wrap: anywhere; }
  .home-section { padding-top: 28px; margin-bottom: 68px; }
  .section-heading { margin-bottom: 24px; }
  .section-heading h2 { margin-top: 7px; }
  .section-note { max-width: 330px; color: var(--muted); font-size: .8125rem; }
  .project-list > .project-entry { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px 52px; padding: 34px 0 38px; }
  .project-list > .project-entry:first-child { padding-top: 10px; }
  .project-list > .project-entry:last-child { padding-bottom: 0; }
  .project-list > .has-media { grid-template-columns: minmax(0, 1fr) minmax(260px, 35%); }
  .project-heading { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 9px 16px; }
  .project-index { font-size: .75rem; color: var(--accent); padding: 0; white-space: nowrap; }
  .project-context { font-size: .75rem; margin: 0; flex: 1; min-width: min(100%, 140px); }
  .status { font-size: .6875rem; }
  .project-summary { min-width: 0; max-width: 810px; }
  .project-summary h3 { font-size: 1.5rem; line-height: 1.35; letter-spacing: -.018em; }
  .project-summary > .project-description { font-size: .9375rem; line-height: 1.8; margin: 13px 0 18px; }
  .project-facts { display: flex; flex-wrap: wrap; gap: 5px 22px; font-size: .75rem; }
  .project-facts > div { display: flex; flex-wrap: wrap; gap: 5px 8px; }
  .project-facts dt { color: var(--muted); }
  .project-facts dd { color: var(--ink); }
  .project-evidence { margin-top: 20px; padding-left: 13px; border-left: 2px solid #9fb8c6; }
  .project-evidence > span { display: block; color: var(--muted); font-size: .6875rem; font-weight: 600; letter-spacing: .035em; text-transform: uppercase; }
  .project-evidence p { color: var(--ink); font-size: .875rem; line-height: 1.75; margin-top: 5px; }
  .project-tech { display: flex; flex-wrap: wrap; gap: 5px 13px; list-style: none; padding: 0; margin: 18px 0 20px; font-family: var(--mono); font-size: .6875rem; color: var(--muted); }
  .project-links { display: flex; flex-wrap: wrap; gap: 12px 25px; align-items: center; }
  .case-link, .project-code-link { margin: 0; font-size: .8125rem; }
  .project-code-link { color: var(--muted); text-decoration: none; }
  .project-code-link:hover { color: var(--accent); text-decoration: underline; }
  .project-visual { min-width: 0; align-self: center; }
  .project-preview { display: block; padding: 7px; background: var(--soft); border: 1px solid var(--line); border-radius: 4px; }
  .project-preview img { width: 100%; height: auto; }
  .project-visual figcaption { font-size: .6875rem; margin-top: 9px; }
  .background-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .background-sections .home-section { margin-bottom: 0; }
  .background-sections h2 { font-size: 1.45rem; }
  .award-row { grid-template-columns: 45px minmax(0, 1fr); gap: 18px; }
  .award-row h3 { font-size: 1rem; line-height: 1.55; }
  .award-row p { font-size: .875rem; }
  .award-row p.small-muted { margin-top: 4px; font-size: .75rem; }
  .skills-list > div { display: block; padding: 13px 0; }
  .skills-list > div:first-child { padding-top: 20px; }
  .skills-list > div:last-child { border: 0; }
  .skills-list dt { font-size: .8125rem; }
  .skills-list dd { margin-top: 5px; font-size: .875rem; line-height: 1.8; }
  @media (max-width: 1000px) {
    .intro { grid-template-columns: 180px minmax(0, 1fr); gap: 38px; padding: 46px 0 50px; }
    .intro-profile { width: 180px; }
    .project-list > .has-media { grid-template-columns: minmax(0, 1fr) minmax(220px, 34%); gap: 18px 28px; }
    .project-summary h3 { font-size: 1.3rem; }
    .background-sections { gap: 36px; }
  }
  @media (max-width: 760px) {
    .intro { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 26px; padding: 34px 0 42px; align-items: start; }
    .intro-profile { width: 120px; padding-top: 5px; }
    .intro-profile figcaption { font-size: .6875rem; }
    .intro h1 { font-size: 2.2rem; }
    .intro h1 span { font-size: .9375rem; margin-top: 9px; }
    .intro-copy > .eyebrow { font-size: .6875rem; }
    .intro-field { font-size: .875rem; }
    .intro-summary { font-size: .9375rem; }
    .intro-links { gap: 15px; }
    .project-list > .project-entry { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 28px 0 34px; }
    .project-visual { width: 100%; max-width: 480px; }
    .project-summary h3 { font-size: 1.4rem; }
    .project-heading { gap: 8px 12px; }
    .section-heading .eyebrow { margin-top: 0; }
    .section-note { margin-top: 12px; }
    .home-section { margin-bottom: 46px; }
    .background-sections { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 480px) {
    .intro { grid-template-columns: minmax(0, 1fr); gap: 23px; }
    .intro-profile { width: 132px; }
    .intro-profile figcaption { text-align: left; }
    .intro h1 { font-size: 2.35rem; }
    .intro h1 span { display: inline; margin-left: 7px; }
    .intro-links { align-items: flex-start; flex-direction: column; }
    .project-context { min-width: 125px; }
  }
  @media print { .intro-links .primary-link { display: none; } .background-sections { display: block; } }
</style>
