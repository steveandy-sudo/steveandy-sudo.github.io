---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchInterests from './ResearchInterests.astro';
import ReservedMedia from './ReservedMedia.astro';
import RepositoryAccess from './RepositoryAccess.astro';
import { allProjects, projectUrl, statusLabel } from '../lib/projects';

const research = {
  lead: 'How can a vehicle make better decisions with incomplete information?',
  summary: 'My interests lie in autonomous-driving perception, decision-making, and deep learning. Building an imitation-learning pipeline and integrating ROS 2 controllers led me to look more closely at how predictions translate into vehicle behavior. I want to pursue end-to-end driving research through implementation and experiments, especially under occlusion and input delay. My current capstone design compares camera-only driving with infrastructure-camera assistance for a hidden-pedestrian scenario.',
  topics: [
    { title: 'Perception under occlusion', description: 'How can a vehicle respond to what it cannot yet see?' },
    { title: 'Decisions and vehicle response', description: 'How do input and steering delays change driving behavior?' },
    { title: 'Learning-based & E2E driving', description: 'How can experiments reveal the limits of learned behavior?' },
  ],
};
const entries = await allProjects();
const projects = entries.filter(({data}) => data.lang === 'en' && data.featured);
type HomeProject = {
  title: string; summary: string; result: string; resultLabel?: string;
  visual?: { src?: string; alt?: string; title: string; caption?: string; kind?: 'image' | 'video' };
};
const projectCopy: Record<string, HomeProject> = {
  'kookmin-ai-edge': {
    title: 'Kookmin AI-Edge Challenge',
    summary: 'Built an imitation-learning pipeline, trained a YOLO detector, and integrated mission logic on the competition vehicle.',
    result: 'Team result: preliminary 2nd, finals 13th with course completion, and Parking Special Award.',
    visual: {
      src: '/media/projects/kookmin-ai-edge/01-competition-vehicle.jpg',
      alt: 'Team KAI competition vehicle on the Kookmin course',
      title: 'Competition vehicle',
      caption: 'Competition broadcast · Team KAI vehicle',
    },
  },
  'ai-sw-mobility': {
    title: 'AI·SW Mobility: Decision-Making & AEB',
    summary: 'Presented a Pure Pursuit–Stanley blending strategy, then wrote and revised the controller code. My work also covers ROS 2 path generation, AEB stop logic, comparison tests, and the high-level control section of the team report.',
    result: 'Completed waypoint runs on both courses at 10 m/s during venue practice. AEB commands triggered at 50 km/h, but a brake fault prevented stopping within the zone.',
    resultLabel: 'Vehicle trials',
    visual: {
      src: '/media/projects/ai-sw-mobility/03-final-course-waypoint-poster.jpg',
      alt: 'Onboard view of final-course waypoint driving',
      title: 'Final-course venue practice',
      caption: 'Final-course waypoint driving · Venue practice',
    },
  },
  'camera-v2i-e2e': {
    title: 'Camera-Based V2I & End-to-End Driving',
    summary: 'Designing camera-only and V2I-assisted E2E driving for a 1/5-scale test vehicle in an occluded-pedestrian scenario.',
    result: 'Defined the occlusion scenario and comparison architecture. Geometry, latency, and stopping-distance requirements are in design; implementation is planned.',
    resultLabel: 'Design in progress',
    visual: { src: '/media/projects/camera-v2i/02-week4-e2e-comparison.png', alt: 'Camera-only and V2I-assisted E2E comparison design', title: 'E2E comparison design', caption: 'Proposed camera-only and V2I-assisted comparison', kind: 'image' },
  },
  'uav-waypoint': {
    title: 'UAV Waypoint Mission',
    summary: 'A ROS 2 mission package for sequential 3D waypoints, TF2 arrival checks, and PX4 offboard integration.',
    result: 'Waypoint tracking and final landing completed in the PX4 SITL/Gazebo demonstration.',
    resultLabel: 'Simulation result',
    visual: {
      src: '/media/projects/uav-waypoint/01-waypoint-flight-poster.jpg',
      alt: 'UAV flying past a building during a simulated waypoint test',
      title: 'UAV waypoint flight',
      caption: 'PX4 SITL / Gazebo · Waypoint flight',
      kind: 'image',
    },
  },
  'vmodel-neuro-symbolic': {
    title: 'Dream Semester: Decision & Control',
    summary: 'An early ROS 2 / CARLA project exploring Pure Pursuit, longitudinal control, and vehicle-command integration.',
    result: 'Path tracking remained unstable in simulation. The project ended without achieving stable autonomous driving or a real-vehicle run.',
    resultLabel: 'Outcome & lessons',
    visual: {
      src: '/media/projects/vmodel-neuro-symbolic/01-carla-simulation-poster.jpg',
      alt: 'Dream Semester CARLA simulation with ROS 2 control terminals',
      title: 'CARLA simulation test',
      caption: 'Dream Semester · CARLA simulation test',
      kind: 'image',
    },
  },
};
const skills = [
  { label: 'Programming', tools: 'Python, C++' },
  { label: 'Autonomous systems', tools: 'ROS 2, CARLA, Gazebo, PX4 SITL' },
  { label: 'AI & computer vision', tools: 'PyTorch, YOLO, OpenCV, Roboflow' },
  { label: 'Development & inspection', tools: 'Ubuntu, Git/GitHub, Foxglove, RViz2, rosbag2, QGroundControl' },
];
---
<BaseLayout title="Junghun Hwang | Autonomous Driving & AI Portfolio" description={'Engineering work in autonomous driving, ROS 2 decision-making, AI perception, and system integration. Technical case studies by Junghun Hwang.'}>
  <main id="main" class="container home-page">
    <section class="intro" aria-labelledby="intro-title">
      <figure class="intro-profile">
        <div class="intro-portrait">
          <img src="/media/profile/junghun-hwang.webp" alt="Portrait of Junghun Hwang" width="1632" height="2044" fetchpriority="high" />
        </div>
        <figcaption>Undergraduate · Konkuk University</figcaption>
      </figure>
      <div class="intro-copy">
        <p class="eyebrow">Smart Vehicle Engineering · Konkuk University</p>
        <h1 id="intro-title">Junghun Hwang <span lang="ko">황정헌</span></h1>
        <p class="intro-field">Autonomous Driving · Perception · Learning</p>
        <p class="intro-summary">I build and test perception, decision-making, and control software for autonomous vehicles. Through competition vehicles and simulation projects, I am exploring how learning-based models and control algorithms work together in practice.</p>
        <dl class="intro-details">
          <div><dt>{'Born'}</dt><dd><time datetime="2001-12-10">2001.12.10</time></dd></div>
          <div><dt>{'Based in'}</dt><dd>Seoul, Korea</dd></div>
        </dl>
        <div class="intro-links">
          <a class="primary-link" href="#projects">{'Explore projects'} <span aria-hidden="true">↓</span></a>
          <a class="email-link" href="mailto:stevehwang1210@gmail.com">stevehwang1210@gmail.com <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <ResearchInterests {...research} />
    <section id="projects" class="home-section projects-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div><h2 id="projects-title">{'Projects'}</h2></div>
        <p class="section-note">From learning pipelines to vehicle experiments.</p>
      </div>
      <ol class="project-list">
        {projects.map(({ data }) => {
          const copy = projectCopy[data.slug];
          const visual = copy?.visual;
          const url = projectUrl(data);
          return (
            <li class:list={['project-entry', { 'has-media': !!visual }]}>
              <div class="project-heading">
                <span class="project-index" aria-hidden="true">{String(data.order).padStart(2, '0')}</span>
                <p class="project-context">{data.context}</p>
                <span class={`status ${data.status}`}>{statusLabel.en[data.status]}</span>
              </div>
              <div class="project-summary">
                <h3><a href={url}>{copy?.title ?? data.title}</a></h3>
                <p class="project-description">{copy?.summary ?? data.summary}</p>
                <div class="project-evidence"><span>{copy?.resultLabel ?? 'Competition result'}</span><p>{copy?.result ?? data.outcome}</p></div>
                <ul class="project-tech" aria-label={'Technologies'}>{data.technologies.map(tech => <li>{tech}</li>)}</ul>
                {data.github && <div class="project-links">
                  <RepositoryAccess href={data.github} visibility={data.githubVisibility} privateReason={data.githubPrivateReason} label="GitHub" accessibleName={`${copy?.title ?? data.title} — GitHub`} />
                </div>}
              </div>
              {visual && <div class="project-visual">
                {visual.src ? <figure>
                  <a class="project-preview" href={url}><img src={visual.src} alt={visual.alt ?? visual.title} width={['uav-waypoint', 'vmodel-neuro-symbolic'].includes(data.slug) ? 960 : data.slug === 'ai-sw-mobility' ? 1280 : data.slug === 'camera-v2i-e2e' ? 1600 : 1576} height={['uav-waypoint', 'vmodel-neuro-symbolic'].includes(data.slug) ? 540 : data.slug === 'ai-sw-mobility' ? 720 : data.slug === 'camera-v2i-e2e' ? 900 : 884} loading="lazy" decoding="async" /></a>
                  <figcaption>{visual.caption}</figcaption>
                </figure> : <ReservedMedia title={visual.title} kind={visual.kind ?? 'image'} />}
              </div>}
            </li>
          );
        })}
      </ol>
    </section>
    <div class="background-sections">
      <section id="awards" class="home-section" aria-labelledby="awards-title">
        <div class="section-heading"><div><p class="eyebrow">{'Competition record'}</p><h2 id="awards-title">{'Awards & competitions'}</h2></div></div>
        <div class="award-row"><span class="year">2026</span><div><h3>{'Kookmin AI-Edge Challenge'}</h3><p>{'Parking Special Award · Preliminary 2nd'}</p><p class="small-muted">{'Finals 13th, course completed · Team result'}</p></div></div>
        <div class="award-row"><span class="year">2026</span><div><h3>Hyundai Mobis Technical Special Award</h3><p>Autonomous Driving Division · Awarded to Team K.A.I.</p><p class="small-muted">For the decision-control presentation by Woojin Hwang and Junghun Hwang</p></div></div>
        <div class="award-row"><span class="year">2022</span><div><h3>Drone Clash</h3><p>{'General Division · 3rd Place'}</p></div></div>
      </section>
      <section id="skills" class="home-section" aria-labelledby="skills-title">
        <div class="section-heading"><div><p class="eyebrow">{'Tools used in projects'}</p><h2 id="skills-title">{'Technical skills'}</h2></div></div>
        <dl class="skills-list">{skills.map(({label,tools}) => <div><dt>{label}</dt><dd>{tools}</dd></div>)}</dl>
      </section>
    </div>
  </main>
</BaseLayout>
<style>
  .intro { max-width: 1080px; margin-inline: auto; padding: 76px 0 82px; grid-template-columns: 228px minmax(0, 1fr); align-items: center; gap: clamp(44px, 6vw, 90px); }
  .intro-profile { width: 228px; max-width: 100%; }
  .intro-portrait { aspect-ratio: 3 / 4; overflow: hidden; border-radius: 12px; background: var(--soft); box-shadow: 0 8px 32px #172c3b0d; }
  .intro-profile img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.18); transform-origin: 50% 20%; }
  .intro-profile figcaption { margin-top: 15px; color: var(--muted); font-size: .7rem; text-align: center; }
  .intro-copy > .eyebrow { font-family: var(--font); letter-spacing: .055em; font-size: .69rem; }
  .intro h1 { font-size: clamp(2.5rem, 4.7vw, 3.6rem); margin: 18px 0 14px; font-weight: 650; }
  .intro h1 span { font-size: 1rem; margin-left: 8px; }
  .intro-field { font-size: 1.02rem; font-weight: 500; }
  .intro-summary { max-width: 625px; margin-top: 22px; font-size: .975rem; line-height: 1.85; }
  .intro-details { display: flex; flex-wrap: wrap; gap: 8px 25px; margin-top: 22px; font-size: .75rem; }
  .intro-details > div { display: flex; gap: 8px; }
  .intro-details dt { color: var(--muted); }
  .intro-details dd { color: var(--ink); }
  .intro-links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 27px; font-size: .8rem; }
  .primary-link { display: inline-flex; gap: 28px; justify-content: space-between; align-items: center; background: var(--ink); color: #fff; padding: 11px 18px; border: 1px solid var(--ink); border-radius: 5px; text-decoration: none; }
  .primary-link:hover { background: var(--accent); border-color: var(--accent); }
  .email-link { overflow-wrap: anywhere; }
  .home-section { padding-top: 32px; margin-bottom: 80px; }
  .section-heading { margin-bottom: 25px; }
  .section-heading h2 { font-size: 2rem; font-weight: 600; }
  .section-note { color: var(--muted); font-size: .875rem; }
  .projects-section { border-top: 0; }
  .project-list > .project-entry { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px 44px; padding: 42px 0 46px; border-bottom: 1px solid var(--line); }
  .project-list > .project-entry:first-child { padding-top: 25px; }
  .project-list > .project-entry:last-child { padding-bottom: 0; border-bottom: 0; }
  .project-list > .has-media { grid-template-columns: minmax(0, .95fr) minmax(0, 1.15fr); }
  .project-heading { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .project-index { font-size: .7rem; color: var(--accent); padding: 0; white-space: nowrap; }
  .project-context { font-size: .75rem; margin: 0; flex: 1; min-width: 140px; }
  .status { font-size: .6875rem; border-radius: 20px; padding: 3px 10px; }
  .project-summary { min-width: 0; grid-column: 2; grid-row: 2; }
  .project-summary h3 { font-size: 1.6rem; line-height: 1.3; letter-spacing: -.025em; }
  .project-summary h3 a { text-decoration: none; }
  .project-summary h3 a::after { content: ' →'; color: var(--accent); font-size: 1.05rem; white-space: nowrap; }
  .project-summary h3 a:hover { text-decoration: underline; }
  .project-summary > .project-description { font-size: .9rem; line-height: 1.85; margin: 14px 0 19px; }
  .project-evidence { padding: 15px 18px; border-radius: 5px; background: var(--soft); }
  .project-evidence > span { display: block; color: var(--accent); font-size: .68rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; }
  .project-evidence p { color: var(--ink); font-size: .825rem; line-height: 1.75; margin-top: 5px; }
  .project-tech { display: flex; flex-wrap: wrap; gap: 5px 8px; list-style: none; padding: 0; margin: 17px 0 18px; font-size: .66rem; color: var(--muted); }
  .project-tech li { border: 1px solid var(--line); border-radius: 3px; padding: 2px 7px; }
  .project-links { display: flex; flex-wrap: wrap; align-items: center; }
  .project-visual { min-width: 0; grid-column: 1; grid-row: 2; align-self: start; padding-top: 4px; }
  .project-preview { display: block; overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: var(--soft); }
  .project-preview img { width: 100%; height: auto; transition: transform .25s ease; }
  .project-preview:hover img { transform: scale(1.025); }
  .project-preview:focus-visible { outline-offset: 5px; }
  .project-visual figcaption { font-size: .68rem; margin-top: 10px; }
  .background-sections { display: grid; grid-template-columns: 1.15fr 1fr; gap: 70px; }
  .background-sections .home-section { margin-bottom: 0; border-top: 1px solid var(--line); }
  .background-sections h2 { font-size: 1.55rem; margin-top: 8px; }
  .background-sections .eyebrow { font-family: var(--font); font-size: .65rem; }
  .award-row { grid-template-columns: 42px minmax(0, 1fr); gap: 18px; }
  .award-row .year { color: var(--muted); font-size: .75rem; }
  .award-row h3 { font-size: .98rem; line-height: 1.5; }
  .award-row p { font-size: .8rem; }
  .award-row p.small-muted { margin-top: 5px; font-size: .73rem; }
  .skills-list > div { display: block; padding: 16px 0; }
  .skills-list > div:first-child { padding-top: 20px; }
  .skills-list > div:last-child { border: 0; }
  .skills-list dt { font-size: .8rem; }
  .skills-list dd { margin-top: 5px; font-size: .84rem; line-height: 1.8; }
  @media (max-width: 1000px) {
    .intro { grid-template-columns: 190px minmax(0, 1fr); gap: 40px; padding: 52px 0 60px; }
    .intro-profile { width: 190px; }
    .project-list > .has-media { gap: 20px 30px; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
    .project-summary h3 { font-size: 1.4rem; }
    .background-sections { gap: 36px; }
  }
  @media (max-width: 760px) {
    .intro { display: grid; grid-template-columns: 142px minmax(0, 1fr); gap: 25px; padding: 38px 0 44px; align-items: start; }
    .intro-profile { width: 142px; padding-top: 6px; }
    .intro-profile figcaption { font-size: .65rem; }
    .intro h1 { font-size: 2.3rem; }
    .intro h1 span { font-size: .875rem; margin: 10px 0 0; }
    .intro-copy > .eyebrow { font-size: .64rem; }
    .intro-field { font-size: .875rem; }
    .intro-summary { font-size: .9rem; }
    .intro-links { gap: 17px; }
    .project-list > .project-entry { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 30px 0 38px; }
    .project-heading { grid-row: 1; gap: 8px 10px; }
    .project-visual { grid-column: 1; grid-row: 2; padding-top: 0; width: 100%; }
    .project-summary { grid-column: 1; grid-row: 3; }
    .project-summary h3 { font-size: 1.45rem; }
    .project-summary > .project-description { font-size: .9375rem; }
    .project-evidence p { font-size: .875rem; }
    .section-heading h2 { font-size: 1.8rem; }
    .section-note { margin-top: 9px; }
    .home-section { margin-bottom: 50px; padding-top: 20px; }
    .background-sections { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 520px) {
    .intro { grid-template-columns: minmax(0, 1fr); gap: 25px; }
    .intro-profile { width: 132px; margin-inline: auto; }
    .intro-profile figcaption { display: none; }
    .intro-copy > .eyebrow, .intro h1, .intro-field { text-align: center; }
    .intro h1 { font-size: 2.45rem; }
    .intro h1 span { display: block; margin: 10px 0 0; }
    .intro-links { align-items: flex-start; flex-direction: column; }
    .project-context { min-width: 120px; }
  }
  @media (prefers-reduced-motion: reduce) { .project-preview img { transition: none; } }
  @media print { .intro-links .primary-link { display: none; } .background-sections { display: block; } .project-preview img { transform: none; } }
</style>
