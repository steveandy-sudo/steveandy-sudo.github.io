---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchInterests from './ResearchInterests.astro';
import { allProjects, projectUrl, statusLabel, type Language } from '../lib/projects';
interface Props { lang: Language; }
const { lang } = Astro.props;
const ko = lang === 'ko';
const research = ko ? {
  summary: '자율주행의 인지와 판단에 관심이 있으며, 딥러닝과 학습 기반 방법을 중심으로 연구하고 싶습니다. 센서 데이터에서 주변 환경을 이해하는 과정이 상황에 맞는 주행 행동으로 어떻게 이어지는지 탐구하고자 합니다. 특히 학습 기반 주행 모델을 직접 개발하고 평가하면서 End-to-End(E2E) 자율주행에 대한 이해를 넓히고 싶습니다. 다양한 교통 상황에서 모델의 행동을 분석하고, 주행 환경이 달라졌을 때 나타나는 성능 변화와 한계를 살펴보며 더 신뢰할 수 있는 자율주행을 위한 개선 방향을 찾고자 합니다.',
  topics: [
    { title: '자율주행 인지', description: '센서 데이터를 통해 주변 객체와 도로 상황을 이해하는 방법에 관심이 있습니다.' },
    { title: '자율주행 판단', description: '인지한 정보를 바탕으로 교통 상황에 맞는 주행 행동을 결정하는 방법을 연구하고 싶습니다.' },
    { title: '딥러닝과 E2E 자율주행', description: '센서 입력에서 주행 행동까지 연결하는 학습 기반 모델을 구현하고, 다양한 주행 상황에서 그 성능과 한계를 탐구하고 싶습니다.' },
  ],
} : {
  summary: 'I am interested in perception and decision-making for autonomous driving, with a focus on deep learning and learning-based approaches. I want to understand how models connect scene understanding from sensor data with appropriate driving actions. I am particularly interested in exploring end-to-end (E2E) autonomous driving by developing and evaluating learning-based driving models. Through experiments across different traffic scenarios, I hope to examine how these models behave, understand their limitations under changing driving conditions, and identify ways to make their behavior more reliable.',
  topics: [
    { title: 'Perception', description: 'Understanding surrounding objects and road scenes through sensor data.' },
    { title: 'Decision-making', description: 'Using perception to select driving actions that respond to traffic conditions.' },
    { title: 'Deep learning & E2E driving', description: 'I want to build learning-based models that map sensor inputs to driving actions and investigate their performance and limitations across driving scenarios.' },
  ],
};
const entries = await allProjects();
const projects = entries.filter(({data}) => data.lang === 'en' && data.featured);
const koSummaries: Record<string,string> = {
  'kookmin-ai-edge':'모방학습 파이프라인, Roboflow·YOLO 학습, Mission Manager / Final Driver 통합 및 실차 튜닝.',
  'ai-sw-mobility':'ROS 2 AEB 파이프라인 공동 개발, Stanley 경로 추종, 시뮬레이션 검증 및 실차 초기 시험.',
  'camera-v2i-e2e':'사각지대 보행자 시나리오의 Camera-only E2E와 V2I-assisted E2E 비교 실험 설계.',
  'uav-waypoint':'3D waypoint 순차 추종 패키지 개발과 기존 PX4 offboard controller 연동.',
  'vmodel-neuro-symbolic':'ROS 2·CARLA 판단·제어 통합과 경로 추종 실험. 안정적인 자율주행에는 도달하지 못함.',
};
const skills = [['Languages','Python, C++'],['Autonomous systems','ROS 2, CARLA, Gazebo, PX4 SITL'],['AI / computer vision','PyTorch, YOLO, OpenCV, Roboflow'],['Tools / environment','Ubuntu, Git/GitHub, Foxglove, RViz2, rosbag2, QGroundControl']];
---
<BaseLayout title="Junghun Hwang | Autonomous Driving & AI Portfolio" description={ko ? '황정헌의 자율주행·AI·자율시스템 프로젝트와 기술 기록.' : 'Engineering work in autonomous driving, ROS 2 decision-making, AI perception, and system integration. Technical case studies by Junghun Hwang.'} lang={lang} alternate={{lang: ko ? 'en' : 'ko', href: ko ? '/' : '/ko/'}}>
  <main id="main" class="container home-page">
    <section class="intro" aria-labelledby="intro-title">
      <div>
        <p class="eyebrow">Engineering portfolio / Konkuk University</p>
        <h1 id="intro-title">Junghun Hwang <span lang="ko">황정헌</span></h1>
        <p class="intro-field">Autonomous Driving / AI / Autonomous Systems</p>
        <p class="intro-summary">{ko ? '건국대학교 스마트운행체공학과 학부생입니다. ROS 2 기반 판단·제어, AI 인지, 시스템 통합을 구현하고 시뮬레이션과 실차 실험으로 확인합니다.' : 'I study Smart Mobility Engineering at Konkuk University. My work connects ROS 2 decision-making, AI perception, and control integration through simulation and initial vehicle experiments.'}</p>
        <dl class="intro-details">
          <div><dt>{ko ? '생년월일' : 'Date of birth'}</dt><dd><time datetime="2001-12-10">2001.12.10</time></dd></div>
          <div><dt>{ko ? '거주지' : 'Based in'}</dt><dd>Seoul, Korea</dd></div>
        </dl>
        <a class="contact-link" href="mailto:stevehwang1210@gmail.com">stevehwang1210@gmail.com <span aria-hidden="true">↗</span></a>
      </div>
      <div class="intro-note"><span class="eyebrow">Focus</span><p>Implementation<br />Integration<br />Experimentation</p><span class="small-muted">{ko ? '2027년 2월 졸업 예정' : 'B.S. expected February 2027'}</span></div>
    </section>
    <ResearchInterests lang={lang} {...research} />
    <section id="projects" class="home-section" aria-labelledby="projects-title"><div class="section-heading"><h2 id="projects-title">{ko ? '주요 프로젝트' : 'Selected projects'}</h2><span class="eyebrow">01—05 / Technical case studies</span></div>
      <ol class="project-list">{projects.map(({data}) => { const translated = entries.find(e => e.data.slug === data.slug && e.data.lang === lang); const target = translated?.data ?? data; return <li><span class="project-index" aria-hidden="true">{String(data.order).padStart(2,'0')}</span><div class="project-summary"><p class="project-context">{data.context}</p><h3><a href={projectUrl(target)}>{ko ? data.titleKo ?? data.title : data.title}</a></h3><p>{ko ? koSummaries[data.slug] : data.summary}</p><div class="technology-tags">{data.technologies.map(tech => <span>{tech}</span>)}</div><a class="case-link" href={projectUrl(target)}>{ko ? `기술 문서 보기${target.lang === 'en' ? ' (English)' : ''}` : 'View technical case study'} <span aria-hidden="true">→</span></a></div><div class="project-side"><span class={`status ${data.status}`}>{statusLabel[lang][data.status]}</span><p>{data.period}</p><p>{data.role}</p></div></li>; })}</ol>
    </section>
    <section id="awards" class="home-section" aria-labelledby="awards-title"><div class="section-heading"><h2 id="awards-title">{ko ? '수상 및 경진대회' : 'Awards & competitions'}</h2></div><div class="award-row"><span class="year">2026</span><div><h3>{ko ? '국민대 자율주행 경진대회 AI-엣지 챌린지' : 'Kookmin AI-Edge Challenge'}</h3><p>{ko ? '예선 2위 · 본선 완주 13위 · 주차경기 특별상' : 'Preliminary 2nd · Finals 13th, course completed · Parking Special Award'}</p><span class="small-muted">{ko ? '팀 성과' : 'Team result'}</span></div></div><div class="award-row"><span class="year">2022</span><div><h3>Drone Clash</h3><p>{ko ? '일반부 3위' : 'General Division — 3rd Place'}</p></div></div></section>
    <section id="skills" class="home-section" aria-labelledby="skills-title"><div class="section-heading"><h2 id="skills-title">{ko ? '기술 역량' : 'Technical skills'}</h2></div><dl class="skills-list">{skills.map(([label,tools]) => <div><dt>{label}</dt><dd>{tools}</dd></div>)}</dl></section>
  </main>
</BaseLayout>

<style>
  .intro-details { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 22px; font-size: .875rem; }
  .intro-details > div { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .intro-details dt { color: var(--muted); }
  .intro-details dd { color: var(--ink); }
</style>
