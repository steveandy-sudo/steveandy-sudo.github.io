---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchInterests from './ResearchInterests.astro';
import { allProjects, projectUrl, statusLabel, type Language } from '../lib/projects';
interface Props { lang: Language; }
const { lang } = Astro.props;
const ko = lang === 'ko';
const research = ko ? {
  summary: '자율주행의 인지·판단과 딥러닝 기반 주행을 연구하고 싶습니다. 모방학습 파이프라인과 ROS 2 판단·제어를 구현하고 실차 통합을 경험하면서, 센서 입력에서 나온 예측이 실제 차량의 행동으로 이어지는 과정에 관심을 갖게 되었습니다. 특히 End-to-End(E2E) 모델을 직접 구현하고, 가림이나 입력 지연이 있는 상황에서 모델의 행동과 한계를 실험으로 살펴보고 싶습니다. 현재는 주정차 차량에 가려진 보행자 상황에서 인프라 카메라 정보가 주행 판단과 제동 시점에 주는 영향을 비교하는 실험을 설계하고 있습니다.',
  topics: [
    { title: '인지와 가림', description: '가려진 객체와 불확실한 인지 정보가 주행 행동에 미치는 영향을 살펴보고 싶습니다.' },
    { title: '판단과 차량 응답', description: '인지·판단의 출력이 조향과 제동으로 이어지는 과정과 시간 지연의 영향을 연구하고 싶습니다.' },
    { title: '학습 기반·E2E 주행', description: '동일한 시나리오에서 모델과 입력 조건을 비교하고, 궤적·제동 시점·실패 사례로 행동을 평가하고자 합니다.' },
  ],
} : {
  summary: 'I want to study perception and decision-making for autonomous driving, with a focus on deep learning. My experience building an imitation-learning pipeline and integrating ROS 2 decision and control software motivates an interest in how sensor-based predictions become vehicle behavior. I am particularly interested in implementing end-to-end (E2E) driving models and examining their behavior under occlusion and input delay. My current experiment design compares camera-only driving with infrastructure-camera assistance when a pedestrian is hidden by a parked vehicle.',
  topics: [
    { title: 'Perception under occlusion', description: 'How hidden objects and uncertain perception affect driving behavior.' },
    { title: 'Decisions and vehicle response', description: 'How perception and decisions become steering and braking, including the effects of delay.' },
    { title: 'Learning-based & E2E driving', description: 'Comparing models and inputs in matched scenarios through trajectories, braking response, and failure cases.' },
  ],
};
const entries = await allProjects();
const projects = entries.filter(({data}) => data.lang === 'en' && data.featured);
const koSummaries: Record<string,string> = {
  'kookmin-ai-edge':'모방학습 파이프라인, Roboflow·YOLO 학습, Mission Manager / Final Driver 통합 및 실차 튜닝.',
  'ai-sw-mobility':'ROS 2 AEB, Stanley 경로 추종, 시뮬레이션·초기 실차 시험. 제어 파트의 조향 지연 수정 후 통합 재시험 준비.',
  'camera-v2i-e2e':'사각지대 보행자 시나리오의 Camera-only E2E와 V2I-assisted E2E 비교 실험 설계.',
  'uav-waypoint':'3D waypoint 순차 추종 패키지 개발과 기존 PX4 offboard controller 연동.',
  'vmodel-neuro-symbolic':'드림학기제 ROS 2·CARLA 판단·제어 프로젝트. 실제 차량 주행에 이르지 못한 구현 및 디버깅 과정을 기록.',
};
const highlights: Record<string, { en: string; ko: string }> = {
  'kookmin-ai-edge': { en: 'Preliminary 2nd · Finals completed · Parking Special Award', ko: '팀 성과: 예선 2위 · 본선 완주 · 주차 특별상' },
  'ai-sw-mobility': { en: 'Initial vehicle trials ~7 km/h · Integrated retest pending', ko: '약 7 km/h 초기 실차 시험 · 통합 재시험 대기' },
  'camera-v2i-e2e': { en: 'Research design · Matched camera-only / V2I comparison planned', ko: '연구 설계 · Camera-only / V2I 비교 실험 계획' },
  'uav-waypoint': { en: 'SITL/Gazebo demonstration · Waypoints and landing completed', ko: 'SITL/Gazebo 시연 · waypoint 추종 및 착륙 완료' },
  'vmodel-neuro-symbolic': { en: 'Implementation and debugging record · Driving objective unmet', ko: '구현·디버깅 기록 · 실제 차량 주행 목표 미달' },
};
const skills = [['Languages','Python, C++'],['Autonomous systems','ROS 2, CARLA, Gazebo, PX4 SITL'],['AI / computer vision','PyTorch, YOLO, OpenCV, Roboflow'],['Tools / environment','Ubuntu, Git/GitHub, Foxglove, RViz2, rosbag2, QGroundControl']];
---
<BaseLayout title="Junghun Hwang | Autonomous Driving & AI Portfolio" description={ko ? '황정헌의 자율주행·AI·자율시스템 프로젝트와 기술 기록.' : 'Engineering work in autonomous driving, ROS 2 decision-making, AI perception, and system integration. Technical case studies by Junghun Hwang.'} lang={lang} alternate={{lang: ko ? 'en' : 'ko', href: ko ? '/' : '/ko/'}}>
  <main id="main" class="container home-page">
    <section class="intro" aria-labelledby="intro-title">
      <figure class="intro-profile">
        <img src="/media/profile/junghun-hwang.jpg" alt={ko ? '벚꽃나무 앞에 서 있는 황정헌' : 'Junghun Hwang standing beneath cherry blossoms'} width="1843" height="2458" fetchpriority="high" />
        <figcaption>{ko ? '2027년 2월 졸업 예정' : 'B.S. expected February 2027'}</figcaption>
      </figure>
      <div>
        <p class="eyebrow">Engineering portfolio / Konkuk University</p>
        <h1 id="intro-title">Junghun Hwang <span lang="ko">황정헌</span></h1>
        <p class="intro-field">Autonomous Driving / AI / Autonomous Systems</p>
        <p class="intro-summary">{ko ? '건국대학교 스마트운행체공학과 학부생입니다. ROS 2 기반 판단·제어, AI 인지, 시스템 통합을 구현하고 시뮬레이션과 실차 실험으로 확인합니다.' : 'I study Smart Mobility Engineering at Konkuk University. My work connects ROS 2 decision-making, AI perception, and control integration through simulation and initial vehicle experiments.'}</p>
        <dl class="intro-details">
          <div><dt>{ko ? '생년월일' : 'Date of birth'}</dt><dd><time datetime="2001-12-10">2001.12.10</time></dd></div>
          <div><dt>{ko ? '거주지' : 'Based in'}</dt><dd>Seoul, Korea</dd></div>
        </dl>
        <a class="contact-link" href="mailto:stevehwang1210@gmail.com">stevehwang1210@gmail.com <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <ResearchInterests lang={lang} {...research} />
    <section id="projects" class="home-section" aria-labelledby="projects-title"><div class="section-heading"><h2 id="projects-title">{ko ? '주요 프로젝트' : 'Selected projects'}</h2><span class="eyebrow">01—05 / Technical case studies</span></div>
      <ol class="project-list">{projects.map(({data}) => { const translated = entries.find(e => e.data.slug === data.slug && e.data.lang === lang); const target = translated?.data ?? data; return <li class:list={{ "has-thumbnail": !!data.thumbnail }}><span class="project-index" aria-hidden="true">{String(data.order).padStart(2,'0')}</span><div class="project-summary"><p class="project-context">{data.context}</p><h3><a href={projectUrl(target)}>{ko ? data.titleKo ?? data.title : data.title}</a></h3><p>{ko ? koSummaries[data.slug] : data.summary}</p><p class="project-result">{highlights[data.slug]?.[lang]}</p><div class="technology-tags">{data.technologies.map(tech => <span>{tech}</span>)}</div><a class="case-link" href={projectUrl(target)}>{ko ? `기술 문서 보기${target.lang === 'en' ? ' (English)' : ''}` : 'View technical case study'} <span aria-hidden="true">→</span></a>{data.github && data.githubVisibility === 'public' && <a class="project-code-link" href={data.github}>GitHub <span aria-hidden="true">↗</span></a>}</div><div class="project-side">{data.thumbnail && <a class="project-preview" href={projectUrl(target)}><img src={data.thumbnail.src} alt={ko ? "국민대 대회 코스 위의 Team KAI 차량" : data.thumbnail.alt} width="1576" height="884" loading="lazy" decoding="async" /></a>}<span class={`status ${data.status}`}>{statusLabel[lang][data.status]}</span><p>{data.period}</p><p>{data.role}</p></div></li>; })}</ol>
    </section>
    <section id="awards" class="home-section" aria-labelledby="awards-title"><div class="section-heading"><h2 id="awards-title">{ko ? '수상 및 경진대회' : 'Awards & competitions'}</h2></div><div class="award-row"><span class="year">2026</span><div><h3>{ko ? '국민대 자율주행 경진대회 AI-엣지 챌린지' : 'Kookmin AI-Edge Challenge'}</h3><p>{ko ? '예선 2위 · 본선 완주 13위 · 주차경기 특별상' : 'Preliminary 2nd · Finals 13th, course completed · Parking Special Award'}</p><span class="small-muted">{ko ? '팀 성과' : 'Team result'}</span></div></div><div class="award-row"><span class="year">2022</span><div><h3>Drone Clash</h3><p>{ko ? '일반부 3위' : 'General Division — 3rd Place'}</p></div></div></section>
    <section id="skills" class="home-section" aria-labelledby="skills-title"><div class="section-heading"><h2 id="skills-title">{ko ? '기술 역량' : 'Technical skills'}</h2></div><dl class="skills-list">{skills.map(([label,tools]) => <div><dt>{label}</dt><dd>{tools}</dd></div>)}</dl></section>
  </main>
</BaseLayout>

<style>
  .project-summary > .project-result { font-size: .8125rem; color: var(--accent); margin: 14px 0; font-weight: 600; }
  .project-code-link { display: inline-block; margin-left: 22px; font-size: .875rem; }
  .project-list > li.has-thumbnail { grid-template-columns: 38px minmax(0, 1fr) 280px; }
  .project-preview { display: block; margin-bottom: 16px; }
  .project-preview img { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; }
  @media (min-width: 761px) and (max-width: 1000px) {
    .project-list > li.has-thumbnail { grid-template-columns: 30px minmax(0, 1fr) 220px; }
  }
  @media (max-width: 760px) {
    .project-list > li.has-thumbnail { grid-template-columns: 26px minmax(0, 1fr); }
    .project-preview { flex-basis: 100%; margin: 0 0 8px; }
  }
  .intro { width: 100%; max-width: 960px; margin-inline: auto; padding: 48px 0 44px; grid-template-columns: 210px minmax(0, 1fr); align-items: center; gap: 56px; }
  .intro-profile { width: 210px; max-width: 100%; }
  .intro-profile img { width: 100%; height: auto; aspect-ratio: 1843 / 2458; object-fit: cover; object-position: center; border: 1px solid var(--line); border-radius: 6px; }
  .intro-profile figcaption { margin-top: 12px; color: var(--muted); font-size: .8125rem; text-align: center; }
  .intro-details { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 22px; font-size: .875rem; }
  .intro-details > div { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .intro-details dt { color: var(--muted); }
  .intro-details dd { color: var(--ink); }
  @media (min-width: 761px) and (max-width: 1000px) {
    .intro { grid-template-columns: 180px minmax(0, 1fr); gap: 36px; }
    .intro-profile { width: 180px; }
  }
  @media (max-width: 760px) {
    .intro { display: flex; flex-direction: column; align-items: stretch; gap: 30px; padding: 32px 0 36px; }
    .intro-profile { width: 160px; align-self: center; }
  }
</style>
