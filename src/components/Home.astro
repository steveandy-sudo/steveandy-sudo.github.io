---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchInterests from './ResearchInterests.astro';
import ReservedMedia from './ReservedMedia.astro';
import RepositoryAccess from './RepositoryAccess.astro';
import { allProjects, projectUrl, statusLabel } from '../lib/projects';
import { homeKo, homeProjectsKo, homeTechnologyKo, type HomeProjectCopy } from '../data/homeKo';

interface Props {
  lang?: 'en' | 'ko';
}
const { lang = 'en' } = Astro.props;
const isKo = lang === 'ko';
const researchEn = {
  lead: 'Perception and decision-making for learning-based and end-to-end driving.',
  summary: 'I want to understand how training-data quality and scenario coverage affect closed-loop E2E driving. In competition projects, I trained driving models and used Foxglove logs to compare planning decisions with vehicle responses. In my capstone, I am reviewing vehicle–infrastructure fusion and helping plan a comparison of camera-only and V2I-assisted E2E driving.',
  topics: [
    { title: 'Perception under occlusion', description: 'How can infrastructure sensing support earlier responses to occluded pedestrians?' },
    { title: 'Decisions and vehicle response', description: 'How do input and steering delays change driving behavior?' },
    { title: 'Learning-based & E2E driving', description: 'How do data quality and scenario coverage affect closed-loop E2E driving?' },
  ],
};
const entries = await allProjects();
const projects = entries.filter(({data}) => data.lang === lang && data.featured);
const projectCopyEn: Record<string, HomeProjectCopy> = {
  'kookmin-ai-edge': {
    title: 'Kookmin AI-Edge Challenge',
    summary: 'Developed a ResNet18–LiDAR CNN imitation-learning pipeline, compared YOLOv8n and YOLO11n detectors, and integrated mission transitions and parking logic on the competition vehicle.',
    result: 'Team result: 2nd in the preliminary round, 13th in the final round with course completion, and a Parking Special Award. The final competition run used rule-based driving.',
    visual: {
      src: '/media/projects/kookmin-ai-edge/01-competition-vehicle.jpg',
      alt: 'Team KAI competition vehicle on the Kookmin course',
      title: 'Competition vehicle',
      caption: 'Competition broadcast · Team KAI vehicle',
    },
  },
  'ai-sw-mobility': {
    title: 'AI·SW Mobility: Decision-Making',
    summary: 'Designed ROS 2 mission FSMs, diagnosed a cached-path mismatch in Foxglove, implemented odometry-based reprojection, and ran follow-up vehicle tests.',
    result: 'Team Grand Prize (Minister of Land, Infrastructure and Transport Award) and Creative Technology Special Award. All required missions completed in both preliminary and final rounds.',
    resultLabel: 'Competition result & awards',
    visual: {
      src: '/media/projects/ai-sw-mobility/06-official-final-driving.jpg',
      alt: 'Team KAI competition vehicle during the official final round',
      title: 'Official final-round driving',
      caption: 'Competition vehicle · Official final round',
    },
  },
  'camera-v2i-e2e': {
    title: 'Camera-Based V2I Cooperative End-to-End Autonomous Driving',
    summary: 'Analyzed stopping-based latency requirements and defined capture-to-deceleration measurements for a planned camera-only versus V2I-assisted E2E comparison.',
    result: 'Research and preliminary design. A separate FP32 test of a randomly initialized TCP candidate measured P95 runtime of 21.88 ms over 600 runs on an RTX 5070 Laptop GPU.',
    resultLabel: 'Research & design',
    visual: { src: '/media/projects/camera-v2i/02-week4-e2e-comparison.png', alt: 'Team proposal for comparing camera-only and V2I-assisted E2E planning', title: 'Proposed E2E comparison', caption: 'Team design proposal · Camera-only and V2I-assisted E2E planning', kind: 'image' },
  },
  'uav-waypoint': {
    title: 'UAV Waypoint Mission',
    summary: 'Developed a ROS 2 waypoint mission package with TF2 arrival checks and PX4 offboard integration.',
    result: 'The simulated UAV followed sequential waypoints and completed the final landing in a PX4 SITL/Gazebo course demonstration.',
    resultLabel: 'Simulation result',
    visual: {
      src: '/media/projects/uav-waypoint/01-waypoint-flight-poster.jpg',
      alt: 'UAV flying past a building during a simulated waypoint test',
      title: 'UAV waypoint flight',
      caption: 'PX4 SITL / Gazebo · Waypoint flight',
      kind: 'image',
    },
  },
  'vmodel-neuro-symbolic': {
    title: 'Dream Semester: Decision & Control',
    summary: 'Implemented Pure Pursuit and longitudinal control in ROS 2 / CARLA, then adapted the vehicle-command interface.',
    result: 'Ran closed-loop controller experiments in CARLA and tested wheel actuation with separate control commands while the vehicle was raised on supports.',
    resultLabel: 'Implementation & experiments',
    visual: {
      src: '/media/projects/vmodel-neuro-symbolic/01-carla-simulation-poster.jpg',
      alt: 'Dream Semester CARLA simulation with ROS 2 control terminals',
      title: 'CARLA simulation test',
      caption: 'Dream Semester · CARLA simulation test',
      kind: 'image',
    },
  },
};
const skillsEn = [
  { label: 'Programming', tools: 'Python, C++' },
  { label: 'Autonomy & control', tools: 'ROS 2, FSM-based behavior planning, Pure Pursuit–Stanley tracking' },
  { label: 'Learning & perception', tools: 'PyTorch, imitation learning, YOLO, TorchScript, OpenCV, Roboflow' },
  { label: 'Simulation & UAV', tools: 'CARLA, Gazebo, PX4 SITL, QGroundControl' },
  { label: 'Data & development', tools: 'ROS 2 log analysis, Foxglove, rosbag2 / MCAP, RViz2, Ubuntu, Git/GitHub' },
];
const research = isKo ? homeKo.research : researchEn;
const projectCopy = isKo ? homeProjectsKo : projectCopyEn;
const skills = isKo ? homeKo.skills : skillsEn;
---
<BaseLayout lang={lang} title={isKo ? homeKo.title : 'Junghun Hwang | Autonomous Driving & AI Portfolio'} description={isKo ? homeKo.description : 'Engineering work in autonomous driving, ROS 2 decision-making, AI perception, and system integration. Technical case studies by Junghun Hwang.'}>
  <main id="main" class="container home-page">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-orbit" aria-hidden="true"><svg viewBox="0 0 600 220" fill="none"><path d="M0 180h140c85 0 70-130 160-130h300" /><path d="M0 196h140c100 0 85-130 160-130h300" /><circle cx="300" cy="50" r="4" /></svg></div>
      <figure class="intro-profile" data-reveal>
        <div class="intro-portrait">
          <img src="/media/profile/junghun-hwang-portrait.png" alt={isKo ? homeKo.intro.portraitAlt : 'Portrait of Junghun Hwang'} width="413" height="531" fetchpriority="high" />
        </div>
        <figcaption><span class="profile-caption-line" aria-hidden="true"></span>{isKo ? homeKo.intro.graduation : 'B.S. expected 2028'}</figcaption>
      </figure>
      <div class="intro-copy" data-reveal>
        <p class="eyebrow">{isKo ? homeKo.intro.affiliation : 'Smart Vehicle Engineering · Konkuk University'}</p>
        <h1 id="intro-title">Junghun Hwang<span class="name-period" aria-hidden="true">.</span><span class="korean-name" lang="ko">황정헌</span></h1>
        <p class="intro-field">{isKo ? homeKo.intro.field : 'Autonomous Driving · Perception · Learning'}</p>
        <p class="intro-summary">{isKo ? homeKo.intro.summary : 'I develop ROS 2 decision-making software and analyze driving logs to improve autonomous vehicle behavior. My projects span mission FSMs, obstacle-avoidance trials, and imitation-learning pipelines. These experiences shape my interest in perception and learning-based driving.'}</p>
        <dl class="intro-details">
          <div><dt>{isKo ? homeKo.intro.born : 'Born'}</dt><dd><time datetime="2001-12-10">2001.12.10</time></dd></div>
          <div><dt>{isKo ? homeKo.intro.basedIn : 'Based in'}</dt><dd>{isKo ? homeKo.intro.location : 'Seoul, Korea'}</dd></div>
        </dl>
        <div class="intro-links">
          <a class="primary-link" href="#projects">{isKo ? homeKo.intro.exploreProjects : 'Explore projects'} <span aria-hidden="true">↓</span></a>
          <a class="email-link" href="mailto:stevehwang1210@gmail.com">stevehwang1210@gmail.com <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <ResearchInterests {...research} lang={lang} />
    <section id="projects" class="home-section projects-section" aria-labelledby="projects-title">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">{isKo ? homeKo.labels.engineering : 'Engineering in practice'}</p><h2 id="projects-title">{isKo ? homeKo.labels.projects : 'Projects'}<span class="section-count"> / {String(projects.length).padStart(2, '0')}</span></h2></div>
        <p class="section-note">{isKo ? homeKo.labels.projectsNote : 'From learning pipelines to vehicle experiments.'}</p>
      </div>
      <ol class="project-list">
        {projects.map(({ data }) => {
          const copy = projectCopy[data.slug];
          const visual = copy?.visual;
          const url = projectUrl(data);
          return (
            <li class:list={['project-entry', { 'has-media': !!visual }]} data-reveal>
              <div class="project-heading">
                <span class="project-index" aria-hidden="true">{String(data.order).padStart(2, '0')}</span>
                <p class="project-context">{data.context}</p>
                <span class={`status ${data.status}`}>{statusLabel[lang][data.status]}</span>
              </div>
              <div class="project-summary">
                <h3><a href={url}>{copy?.title ?? data.title}</a></h3>
                <p class="project-description">{copy?.summary ?? data.summary}</p>
                <div class="project-evidence"><span>{copy?.resultLabel ?? (isKo ? homeKo.labels.competitionResult : 'Competition result')}</span><p>{copy?.result ?? data.outcome}</p></div>
                <ul class="project-tech" aria-label={isKo ? homeKo.labels.technologies : 'Technologies'}>{data.technologies.map(tech => <li>{isKo ? homeTechnologyKo[tech] ?? tech : tech}</li>)}</ul>
                {data.github && <div class="project-links">
                  <RepositoryAccess href={data.github} visibility={data.githubVisibility} privateReason={data.githubPrivateReason} lang={lang} label="GitHub" accessibleName={`${copy?.title ?? data.title} — GitHub`} />
                </div>}
              </div>
              {visual && <div class="project-visual">
                {visual.src ? <figure>
                  <a class="project-preview" href={url}><img src={visual.src} alt={visual.alt ?? visual.title} width={['uav-waypoint', 'vmodel-neuro-symbolic'].includes(data.slug) ? 960 : data.slug === 'ai-sw-mobility' ? 1280 : data.slug === 'camera-v2i-e2e' ? 1600 : 1576} height={['uav-waypoint', 'vmodel-neuro-symbolic'].includes(data.slug) ? 540 : data.slug === 'ai-sw-mobility' ? 720 : data.slug === 'camera-v2i-e2e' ? 900 : 884} loading="lazy" decoding="async" /><span class="preview-open" aria-hidden="true">↗</span></a>
                  <figcaption>{visual.caption}</figcaption>
                </figure> : <ReservedMedia title={visual.title} kind={visual.kind ?? 'image'} lang={lang} />}
              </div>}
            </li>
          );
        })}
      </ol>
    </section>
    <div class="background-sections">
      <section id="awards" class="home-section" aria-labelledby="awards-title" data-reveal>
        <div class="section-heading"><div><p class="eyebrow">{isKo ? homeKo.labels.competitionRecord : 'Competition record'}</p><h2 id="awards-title">{isKo ? homeKo.labels.awards : 'Awards & competitions'}</h2></div></div>
        <div class="award-row"><span class="year">2026</span><div><h3>{isKo ? homeKo.awards.mobility.title : 'Student AI·SW Mobility Competition'}</h3><p>{isKo ? homeKo.awards.mobility.grandPrize : 'Grand Prize · Minister of Land, Infrastructure and Transport Award'}</p><p class="small-muted">{isKo ? homeKo.awards.mobility.grandPrizeContext : 'Self-built Autonomous Vehicle · Autonomous Driving Implementation · Team award'}</p><p>{isKo ? homeKo.awards.mobility.specialAward : 'Special Award · Creative Technology'}</p><p class="small-muted">{isKo ? homeKo.awards.mobility.specialAwardContext : 'Self-built Autonomous Vehicle · Technical report · Team award'}</p></div></div>
        <div class="award-row"><span class="year">2026</span><div><h3>{isKo ? homeKo.awards.kookmin.title : 'Kookmin AI-Edge Challenge'}</h3><p>{isKo ? homeKo.awards.kookmin.result : 'Parking Special Award · Preliminary 2nd'}</p><p class="small-muted">{isKo ? homeKo.awards.kookmin.context : 'Finals 13th, course completed · Team result'}</p></div></div>
        <div class="award-row"><span class="year">2026</span><div><h3>{isKo ? homeKo.awards.mobis.title : 'Hyundai Mobis Technical Special Award'}</h3><p>{isKo ? homeKo.awards.mobis.result : 'Autonomous Driving Division · Awarded to Team K.A.I.'}</p><p class="small-muted">{isKo ? homeKo.awards.mobis.context : 'For the decision-control presentation by Woojin Hwang and Junghun Hwang'}</p></div></div>
        <div class="award-row"><span class="year">2022</span><div><h3>{isKo ? homeKo.awards.drone.title : 'Drone Clash'}</h3><p>{isKo ? homeKo.awards.drone.result : 'General Division · 3rd Place'}</p></div></div>
      </section>
      <section id="skills" class="home-section" aria-labelledby="skills-title" data-reveal>
        <div class="section-heading"><div><p class="eyebrow">{isKo ? homeKo.labels.toolsUsed : 'Tools used in projects'}</p><h2 id="skills-title">{isKo ? homeKo.labels.technicalSkills : 'Technical skills'}</h2></div></div>
        <dl class="skills-list">{skills.map(({label,tools}) => <div><dt>{label}</dt><dd>{tools}</dd></div>)}</dl>
      </section>
    </div>
  </main>
</BaseLayout>
<style>
  .intro { position: relative; isolation: isolate; display: grid; max-width: none; grid-template-columns: 240px minmax(0, 1fr); gap: 30px 64px; padding: 60px 0 72px; align-items: center; }
  .intro-orbit { position: absolute; width: 580px; max-width: 75%; top: -38px; right: 0; z-index: -1; opacity: .17; pointer-events: none; overflow: hidden; }
  .intro-orbit svg { width: 100%; height: auto; }
  .intro-orbit path { stroke: var(--accent); stroke-width: .8; }
  .intro-orbit circle { fill: var(--accent); }
  .intro-profile { width: 240px; max-width: 100%; }
  .intro-portrait { aspect-ratio: 3 / 4; overflow: hidden; border-radius: 4px 40px 4px 4px; background: var(--soft); border: 1px solid #3d555c; box-shadow: 12px 12px 0 -1px var(--paper), 12px 12px 0 0 var(--line); }
  .intro-profile img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .intro-profile figcaption { display: flex; align-items: center; gap: 11px; margin-top: 26px; color: var(--muted); font: .64rem var(--mono); letter-spacing: .035em; }
  .profile-caption-line { width: 25px; height: 1px; background: var(--accent); }
  .intro-copy { min-width: 0; padding-bottom: 4px; }
  .intro-copy > .eyebrow { font-size: .64rem; color: var(--accent); letter-spacing: .12em; }
  .intro h1 { font-size: clamp(2.7rem, 5.1vw, 4.2rem); margin: 20px 0 16px; font-weight: 550; line-height: 1.08; letter-spacing: -.055em; }
  .intro h1 .name-period { display: inline; margin: 0; font-size: inherit; color: var(--accent); font-weight: inherit; letter-spacing: inherit; }
  .intro h1 .korean-name { display: inline-block; font-size: .92rem; font-weight: 400; color: var(--muted); margin-left: 15px; vertical-align: baseline; letter-spacing: 0; }
  .intro-field { font-size: .91rem; font-weight: 400; color: #c5d8e0; letter-spacing: .025em; }
  .intro-summary { max-width: 620px; margin-top: 23px; font-size: .92rem; line-height: 1.85; }
  .intro-details { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 21px; font-size: .71rem; }
  .intro-details > div { display: flex; gap: 10px; }
  .intro-details dt { color: var(--muted); }
  .intro-details dd { color: var(--ink); }
  .intro-links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 26px; margin-top: 26px; font-size: .77rem; }
  .primary-link { display: inline-flex; gap: 36px; justify-content: space-between; align-items: center; background: var(--accent); color: #071812; padding: 12px 17px; border: 1px solid var(--accent); border-radius: 3px; text-decoration: none; font-weight: 600; transition: background .2s, transform .2s; }
  .primary-link:hover { background: #a0f5da; color: #071812; transform: translateY(-2px); }
  .email-link { color: var(--body); overflow-wrap: anywhere; text-decoration-color: var(--line); }
  .home-section { padding-top: 34px; margin-bottom: 90px; }
  .section-heading { margin-bottom: 30px; align-items: end; }
  .section-heading .eyebrow { color: var(--accent); font-size: .63rem; letter-spacing: .13em; margin-bottom: 12px; }
  .section-heading h2 { font-size: clamp(2.1rem, 4vw, 3.05rem); font-weight: 450; letter-spacing: -.045em; }
  .section-count { font: .77rem var(--mono); color: var(--muted); letter-spacing: 0; vertical-align: middle; }
  .section-note { color: var(--muted); font-size: .78rem; padding-bottom: 5px; }
  .projects-section { border-top: 0; }
  .project-list > .project-entry { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 25px 50px; padding: 38px 0 50px; border-top: 1px solid var(--line); border-bottom: 0; }
  .project-list > .project-entry:last-child { padding-bottom: 0; }
  .project-list > .has-media { grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); }
  .project-heading { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 15px; }
  .project-index { font-size: .68rem; color: var(--accent); padding: 0; white-space: nowrap; }
  .project-context { font: .66rem var(--mono); margin: 0; flex: 1; min-width: 140px; color: var(--muted); }
  .status { font-size: .62rem; border-radius: 3px; padding: 3px 9px; }
  .project-summary { min-width: 0; grid-column: 2; grid-row: 2; align-self: center; }
  .project-summary h3 { font-size: 1.65rem; line-height: 1.25; letter-spacing: -.035em; font-weight: 500; }
  .project-summary h3 a { text-decoration: none; transition: color .2s; }
  .project-summary h3 a::after { content: ' \2197'; color: var(--accent); font-size: 1rem; white-space: nowrap; }
  .project-summary h3 a:hover { color: var(--accent); }
  .project-summary > .project-description { font-size: .86rem; line-height: 1.85; margin: 16px 0 21px; }
  .project-evidence { padding: 13px 0 13px 16px; border-left: 1px solid #68e0c261; background: linear-gradient(90deg, #68e0c206, transparent); }
  .project-evidence > span { display: block; color: var(--accent); font: .61rem var(--mono); letter-spacing: .065em; text-transform: uppercase; }
  .project-evidence p { color: #c6d7df; font-size: .78rem; line-height: 1.8; margin-top: 7px; }
  .project-tech { display: flex; flex-wrap: wrap; gap: 6px 8px; list-style: none; padding: 0; margin: 19px 0 17px; font-size: .62rem; color: var(--muted); }
  .project-tech li { border: 1px solid var(--line); border-radius: 3px; padding: 2px 7px; }
  .project-links { display: flex; flex-wrap: wrap; align-items: center; font-size: .78rem; }
  .project-visual { min-width: 0; grid-column: 1; grid-row: 2; align-self: center; padding-top: 0; }
  .project-preview { display: block; position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 4px; background: var(--soft); }
  .project-preview img { width: 100%; aspect-ratio: 16 / 9; object-fit: contain; transition: transform .5s ease, filter .5s; filter: saturate(.8); }
  .project-preview:hover img { transform: scale(1.035); filter: saturate(1); }
  .preview-open { position: absolute; bottom: 14px; right: 14px; display: grid; place-items: center; width: 35px; height: 35px; border: 1px solid #a8c9c35c; border-radius: 50%; background: #071019cf; color: var(--ink); font-size: 1rem; transition: background .2s; }
  .project-preview:hover .preview-open { background: var(--accent); color: var(--paper); }
  .project-preview:focus-visible { outline-offset: 5px; }
  .project-visual figcaption { font-size: .65rem; margin-top: 11px; color: var(--muted); }
  .project-entry:nth-child(even) .project-summary { grid-column: 1; }
  .project-entry:nth-child(even) .project-visual { grid-column: 2; }
  .background-sections { display: grid; grid-template-columns: 1.15fr 1fr; gap: 70px; }
  .background-sections .home-section { margin-bottom: 0; border-top: 1px solid var(--line); }
  .background-sections h2 { font-size: 1.75rem; margin-top: 9px; }
  .background-sections .eyebrow { font-size: .6rem; }
  .award-row { grid-template-columns: 42px minmax(0, 1fr); gap: 18px; }
  .award-row .year { color: var(--accent); font: .69rem var(--mono); }
  .award-row h3 { font-size: .96rem; line-height: 1.5; font-weight: 500; }
  .award-row p { font-size: .77rem; }
  .award-row p.small-muted { margin-top: 5px; font-size: .7rem; }
  .skills-list > div { display: block; padding: 17px 0; }
  .skills-list > div:first-child { padding-top: 20px; }
  .skills-list > div:last-child { border: 0; }
  .skills-list dt { color: var(--accent); font: .64rem var(--mono); letter-spacing: .04em; }
  .skills-list dd { margin-top: 7px; font-size: .84rem; line-height: 1.8; }
  @media (max-width: 1000px) {
    .intro { grid-template-columns: 210px minmax(0, 1fr); gap: 30px 42px; padding-top: 45px; }
    .intro-profile { width: 210px; }
    .intro h1 { font-size: 3.2rem; }
    .intro h1 .korean-name { display: block; margin: 12px 0 0; font-size: .85rem; }
    .project-list > .has-media { gap: 24px 30px; }
    .project-summary h3 { font-size: 1.4rem; }
    .background-sections { gap: 36px; }
  }
  @media (max-width: 760px) {
    .intro { grid-template-columns: 150px minmax(0, 1fr); gap: 30px; padding: 38px 0 48px; align-items: start; }
    .intro-orbit { max-width: 85%; right: 0; }
    .intro-profile { width: 150px; padding-top: 5px; }
    .intro-profile figcaption { font-size: .57rem; gap: 6px; }
    .profile-caption-line { width: 12px; }
    .intro h1 { font-size: 2.6rem; margin-top: 14px; }
    .intro-copy > .eyebrow { font-size: .55rem; }
    .intro-field { font-size: .78rem; }
    .intro-summary { font-size: .85rem; }
    .intro-details { font-size: .67rem; }
    .intro-links { gap: 15px; font-size: .7rem; }
    .project-list > .project-entry { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 29px 0 38px; }
    .project-heading { grid-row: 1; gap: 8px 10px; }
    .project-visual, .project-entry:nth-child(even) .project-visual { grid-column: 1; grid-row: 2; width: 100%; }
    .project-summary, .project-entry:nth-child(even) .project-summary { grid-column: 1; grid-row: 3; }
    .project-summary h3 { font-size: 1.55rem; }
    .project-summary > .project-description { font-size: .9rem; }
    .project-evidence p { font-size: .83rem; }
    .section-heading h2 { font-size: 2.2rem; }
    .section-note { margin-top: 11px; }
    .home-section { margin-bottom: 50px; padding-top: 20px; }
    .background-sections { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 520px) {
    .intro { grid-template-columns: minmax(0, 1fr); gap: 29px; padding-top: 30px; }
    .intro-profile { width: 142px; margin-inline: auto; }
    .intro-profile figcaption { display: none; }
    .intro-copy > .eyebrow, .intro h1, .intro-field { text-align: center; }
    .intro h1 { font-size: 2.75rem; }
    .intro h1 .korean-name { display: inline-block; margin: 12px 0 0 8px; font-size: .8rem; }
    .intro-summary { margin-top: 20px; }
    .intro-details { justify-content: center; gap: 8px 17px; }
    .intro-links { justify-content: center; gap: 20px; }
    .project-context { min-width: 120px; }
  }
  @media (prefers-reduced-motion: reduce) { .project-preview img, .preview-open, .primary-link { transition: none; } .primary-link:hover, .project-preview:hover img { transform: none; } }
