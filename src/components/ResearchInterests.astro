---
interface Props {
  lead: string;
  summary: string;
  topics: { title: string; description: string }[];
}
const { lead, summary, topics } = Astro.props;
---
<section id="research" class="home-section" aria-labelledby="research-title">
  <div class="section-heading">
    <div><p class="eyebrow">Research interests</p><h2 id="research-title">Perception, decisions, and learning.</h2></div>
  </div>
  <div class="research-grid">
    <div class="research-statement">
      <p class="research-lead">{lead}</p>
      <p class="research-summary">{summary}</p>

    </div>
    <ul class="research-topics">
      {topics.map((topic, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{topic.title}</h3><p>{topic.description}</p></div></li>)}
    </ul>
  </div>
</section>
<style>
  .home-section { padding: 40px 44px; margin-bottom: 56px; border: 0; border-radius: 12px; background: var(--ink); color: #c8d7df; }
  .eyebrow { color: #a9c5d3; font-family: var(--font); font-size: .67rem; }
  .section-heading { margin-bottom: 28px; }
  .section-heading h2 { margin-top: 10px; color: #fff; font-size: 1.8rem; font-weight: 500; }
  .research-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 62px; }
  .research-lead { font-size: 1.08rem; line-height: 1.65; color: #f2f7fa; }
  .research-summary { margin-top: 16px; font-size: .86rem; line-height: 1.9; }
  .research-topics { list-style: none; padding: 0 0 0 28px; border-left: 1px solid #48606e; align-self: start; }
  .research-topics li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 13px; padding: 15px 0; border-bottom: 1px solid #48606e; }
  .research-topics li:first-child { padding-top: 0; }
  .research-topics li:last-child { padding-bottom: 0; border-bottom: 0; }
  .research-topics li > span { font: .6875rem var(--mono); color: #a9c5d3; padding-top: 6px; white-space: nowrap; }
  .research-topics h3 { color: #fff; font-size: .875rem; line-height: 1.6; font-weight: 500; }
  .research-topics p { margin-top: 5px; font-size: .79rem; line-height: 1.75; }
  @media (max-width: 1000px) { .research-grid { gap: 30px; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } .research-topics { padding-left: 22px; } }
  @media (max-width: 760px) {
    .home-section { margin-bottom: 32px; padding: 28px 24px; }
    .section-heading h2 { font-size: 1.55rem; }
    .section-heading .eyebrow { margin-top: 0; }
    .research-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .research-lead { font-size: 1.05rem; }
    .research-topics { padding-left: 0; border-left: 0; }
    .research-topics li { grid-template-columns: 25px minmax(0, 1fr); }
  }
</style>
