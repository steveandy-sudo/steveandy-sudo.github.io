---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
interface Props { src: string; poster: string; alt: string; caption: string; width?: number; height?: number; lang?: 'en'; }
const { src, poster, alt, caption, width = 1280, height = 720 } = Astro.props;
const playLabel = 'Play GIF';
const stillLabel = 'Show still';
for (const path of [src, poster]) {
  if (!path.startsWith('/media/') || !existsSync(resolve('public', path.slice(1)))) {
    throw new Error(`Missing animation asset: ${path}`);
  }
}
---
<figure class="animated-figure" data-animation={src} data-still={poster} data-play-label={playLabel} data-still-label={stillLabel}>
  <img src={poster} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  <div class="animation-controls">
    <button type="button" aria-label={`${playLabel}: ${alt}`} aria-pressed="false" hidden>{playLabel}</button>
    <a href={src} download>Download GIF ↓</a>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.animated-figure').forEach(figure => {
    const img = figure.querySelector('img');
    const button = figure.querySelector('button');
    if (!img || !button) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      const playing = button.getAttribute('aria-pressed') !== 'true';
      img.src = (playing ? figure.dataset.animation : figure.dataset.still)!;
      button.setAttribute('aria-pressed', String(playing));
      const label = (playing ? figure.dataset.stillLabel : figure.dataset.playLabel)!;
      button.textContent = label;
      button.setAttribute('aria-label', `${label}: ${img.alt}`);
    });
  });
</script>

<style>
  img { width: 100%; height: auto; border: 1px solid var(--line); }
  .animation-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-block: 10px; font-size: .8rem; }
  button { padding: 8px 14px; border: 1px solid var(--accent); border-radius: 3px; background: var(--soft); color: var(--accent); font: inherit; cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media print { .animation-controls { display: none; } }
</style>
