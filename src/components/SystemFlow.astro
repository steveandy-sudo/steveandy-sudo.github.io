---
interface Props {
  title: string;
  steps: { label: string; detail: string }[];
  caption?: string;
}
const { title, steps, caption } = Astro.props;
---
<figure class="system-flow" aria-label={title}>
  <p class="flow-title">{title}</p>
  <ol>{steps.map(step => <li><strong>{step.label}</strong><span>{step.detail}</span></li>)}</ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .system-flow { padding: 22px; border: 1px solid var(--line); background: var(--soft); }
  .system-flow .flow-title { margin: 0 0 16px; color: var(--accent); font-size: .8125rem; font-weight: 650; }
  .system-flow ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; list-style: none; padding: 0; margin: 0; counter-reset: flow; }
  .system-flow li { position: relative; margin: 0; padding: 0 0 0 30px; counter-increment: flow; }
  .system-flow li::before { content: counter(flow, decimal-leading-zero); position: absolute; left: 0; top: 3px; font: .75rem var(--mono); color: var(--accent); }
  .system-flow strong { display: block; font-size: .9375rem; }
  .system-flow span { display: block; font-size: .8125rem; line-height: 1.65; margin-top: 5px; }
  @media(max-width: 560px) { .system-flow ol { grid-template-columns: 1fr; } .system-flow { padding: 18px; } }
</style>
