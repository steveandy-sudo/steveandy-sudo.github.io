---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Figure from './Figure.astro';
import Video from './Video.astro';

interface Props { lang?: 'en' | 'ko'; }
const { lang = 'en' } = Astro.props;
const labels = lang === 'ko' ? {
  summary: '발표 및 수상 자료',
  slides: '발표 슬라이드 (PDF, 한국어)',
  authors: '황우진·황정헌',
  recordingTitle: 'Pure Pursuit–Stanley 기술 발표 영상',
  recordingCaption: 'Pure Pursuit–Stanley 제어 전략을 발표하는 장면이다.',
  certificateAlt: '건국대학교 Team K.A.I.에 수여된 2026 현대모비스 기술특별상 자율주행부문 상장',
  certificateCaption: '기술특별상 · 자율주행부문 · 건국대학교 Team K.A.I.',
  ceremonyAlt: '참석자 뒤로 현대모비스 기술 심포지엄 제목이 보이는 시상식',
  ceremonyCaption: '현대모비스 기술특별상을 수상하는 장면이다.',
} : {
  summary: 'Presentation & award materials',
  slides: 'Presentation slides (PDF, Korean)',
  authors: 'Woojin Hwang & Junghun Hwang',
  recordingTitle: 'Recording of the Pure Pursuit–Stanley technical presentation',
  recordingCaption: 'Presenting the Pure Pursuit–Stanley control strategy.',
  certificateAlt: '2026 Hyundai Mobis Technical Special Award certificate, Autonomous Driving Division, awarded to Konkuk University Team K.A.I.',
  certificateCaption: 'Technical Special Award · Autonomous Driving Division · Konkuk University Team K.A.I.',
  ceremonyAlt: 'Award ceremony with the Hyundai Mobis technical symposium title visible behind the participants',
  ceremonyCaption: 'Receiving the Hyundai Mobis Technical Special Award.',
};

const base = '/media/academic-2026';
const available = (name: string) => existsSync(resolve('public', `${base.slice(1)}/${name}`));
const slides = available('presentation.pdf');
const recording = available('presentation.mp4');
const poster = available('presentation-poster.jpg');
const certificate = available('award.png');
const ceremony = available('ceremony.png');
// TODO: Add the dated event banner when the source photograph is supplied.
// TODO: Add a public code-snapshot link only after its release is approved.
---

{(slides || recording || certificate || ceremony) && (
  <details class="presentation-materials">
    <summary>{labels.summary}</summary>
    {slides && <p><a href={`${base}/presentation.pdf`} target="_blank" rel="noopener">{labels.slides}</a><br /><span class="authors">{labels.authors}</span></p>}
    {recording && <Video src={`${base}/presentation.mp4`} poster={poster ? `${base}/presentation-poster.jpg` : undefined} title={labels.recordingTitle} caption={labels.recordingCaption} portrait lang={lang} />}
    <div class="award-materials">
      {certificate && <Figure src={`${base}/award.png`} alt={labels.certificateAlt} caption={labels.certificateCaption} width={1050} height={1400} />}
      {ceremony && <Figure src={`${base}/ceremony.png`} alt={labels.ceremonyAlt} caption={labels.ceremonyCaption} width={1050} height={1400} />}
    </div>
  </details>
)}

<style>
  .presentation-materials { margin: 28px 0; padding: 20px 24px; border: 1px solid var(--line); border-radius: 10px; background: var(--soft); }
  summary { cursor: pointer; font-weight: 600; color: var(--ink); }
  .authors { color: var(--muted); font-size: .85rem; }
  .award-materials { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; align-items: start; }
  @media (max-width: 650px) { .award-materials { grid-template-columns: minmax(0, 1fr); } }
</style>
